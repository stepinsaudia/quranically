{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "qst-living-knowledge-v1",
  "account_id": "fb9597e74bae3ea18ad7bb013213d776",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-25",
  "workers_dev": true,
  "triggers": {"crons": ["17 4 * * *"]},
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "APP_NAME": "Quranically — The Islamic Reference Encyclopedia",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "ADMIN_EMAIL": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qst-knowledge-v1-db",
      "database_id": "6c7c8edb-e20c-4354-9d69-0bea89badfd9",
      "migrations_dir": "migrations"
    }
  ]
}
